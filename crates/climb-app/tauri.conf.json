{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "攀岩线路高亮",
  "version": "0.1.0",
  "identifier": "com.climb-highlight.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "攀岩线路高亮",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
